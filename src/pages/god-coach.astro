---
import NeuralCanvas from '../components/NeuralCanvas.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { godCoach } from '../data/site';
import portrait from '../assets/portrait.jpg';
import brain from '../assets/portal/maex-labs-monetize-your-mind.jpg';
import room from '../assets/portal/workshop-room-chicago.jpg';
import boards from '../assets/gallery/concept-boards.jpg';
import proto from '../assets/gallery/hive-prototype.jpg';
import studio from '../assets/studio-planning.jpg';
const buy = godCoach.payUrl || '#get';
const roles = [
  ['Generator', 'Creates', 'Pulls ideas, options and angles out of you faster than you can on your own.', boards, 'Marquis mapping ideas on concept boards with a client team', '#c0531a'],
  ['Operator', 'Executes', 'Turns the best idea into concrete next steps you can act on today.', proto, 'A team building a rapid prototype on the floor during a Hive session', '#2c6a3d'],
  ['Destroyer', 'Eliminates', 'Calls out what is in the way: the habit, the task or the assumption to cut.', studio, 'Marquis at a chalk wall in the studio, clearing the plan down to what matters', '#981c24'],
];
const steps = godCoach.payUrl ? [
  ['Pay the ' + godCoach.price + ' setup', 'Check out securely through Stripe. It takes about a minute.'],
  ['Get your prompt instantly', 'Your G.O.D. Coach prompt and setup steps land in your inbox right after payment.'],
  ['Get set up with me', 'Reply with your goal and I help you get the coach running in your own Claude account.'],
] : [
  ['Request your setup', 'Tell me a little about what you want the coach to help with.'],
  ['Pay the ' + godCoach.price + ' setup', 'I email you a secure payment link, usually within 24 to 48 hours.'],
  ['Start coaching', 'I set the G.O.D. Coach up in your own Claude account and show you how to get the most from it.'],
];
---
<Base title="G.O.D. Coach: Your AI Thinking Partner on Claude | Marquis Harmon" description={`The G.O.D. Coach is a Claude coaching prompt built by Marquis Harmon on his G.O.D. Framework: Generator, Operator, Destroyer. ${godCoach.price} one-time setup in your own Claude account.`}>
  <section class="section mind"><NeuralCanvas />
    <div class="wrap split even">
      <div class="stack g22">
        <span class="eyebrow">G.O.D. Coach · built on Claude</span>
        <h1 style="font-size:clamp(2.3rem,5.4vw,4rem)">Your own G.O.D. Framework coach, ready when you are.</h1>
        <p class="lede">The coaching prompt I built on Claude to think the way I teach: generate the ideas, operate on the best one, and destroy what's in the way. It lands in your inbox the moment you pay, and I help you get it running.</p>
        <div class="price-row"><span class="price">{godCoach.price}</span><span class="price-note">one-time setup</span></div>
        <div class="btn-row"><a class="btn btn-primary" href={buy} {...(godCoach.payUrl ? { target: '_blank', rel: 'noopener' } : {})}>Get set up for {godCoach.price}</a><a class="btn btn-secondary" href="#how">How it works</a></div>
      </div>
      <div class="stack-photos" aria-label="Marquis Harmon at work">
        <figure class="sp main"><Image src={portrait} alt="Marquis Harmon, seated, in a thoughtful pose" widths={[480, 800]} sizes="(min-width:900px) 32vw, 70vw" loading="eager" /></figure>
        <figure class="sp a"><Image src={brain} alt="Monetize Your Mind, a MAEx Labs visual" widths={[400, 700]} sizes="(min-width:900px) 22vw, 50vw" loading="eager" /></figure>
        <figure class="sp b"><Image src={room} alt="Marquis Harmon in a full workshop room in Chicago" widths={[300, 600]} sizes="(min-width:900px) 16vw, 40vw" loading="eager" /></figure>
      </div>
    </div>
  </section>

  <section class="section mint"><div class="wrap">
    <div class="head"><span class="eyebrow">Three voices, one coach</span><h2>It thinks with you in three modes.</h2></div>
    <div class="grid c3">
      {roles.map(([n, v, d, im, alt, c]) => <div class="card mode" style={`--c:${c}`}><div class="mode-img"><Image src={im} alt={alt} widths={[400, 700]} sizes="(min-width:900px) 30vw, 100vw" /></div><span class="eyebrow">{v}</span><h3>{n}</h3><p>{d}</p></div>)}
    </div>
    <p style="margin-top:24px;max-width:60ch">At the center is mind mastery: knowing which mode you need right now. The coach helps you practice that every time you use it.</p>
  </div></section>

  <section class="section" id="how"><div class="wrap">
    <div class="head"><span class="eyebrow">How it works</span><h2>Three steps and you're coaching.</h2></div>
    <ol class="grid c3 steps">
      {steps.map(([t, d], i) => <li class="card"><span class="num">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
    <p class="small" style="margin-top:20px;color:var(--muted)">You'll need your own Claude account. Any Claude plan you choose is billed by Anthropic, separately from the {godCoach.price} setup. The G.O.D. Coach is a thinking tool, not therapy, medical, legal or financial advice.</p>
  </div></section>

  <section class="section mint" id="get"><div class="wrap split even">
    <div class="stack g16">
      <span class="eyebrow">Get the G.O.D. Coach</span>
      <h2>{godCoach.payUrl ? 'Pay, then tell me your goal.' : `Request your ${godCoach.price} setup.`}</h2>
      <p>{godCoach.payUrl ? 'Checkout is secure through Stripe, and your prompt arrives by email within minutes. Use the form to tell me what you want the coach for, and I\'ll follow up within 24 to 48 hours to help you set it up.' : 'Tell me what you want to use it for. I\'ll reply with next steps and a secure payment link within 24 to 48 hours.'}</p>
      {godCoach.payUrl && <div><a class="btn btn-primary" href={godCoach.payUrl} target="_blank" rel="noopener">Pay {godCoach.price} now ↗</a></div>}
    </div>
    <form class="form card" name="god-coach" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="god-coach" />
      <p class="hp"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="row">
        <label>Full name<input type="text" name="name" required autocomplete="name" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
      </div>
      <label>Do you already have a Claude account?
        <select name="has-claude"><option>Yes</option><option>No, help me set one up</option><option>Not sure</option></select>
      </label>
      <label>What do you want the coach to help you with?<textarea name="goal" rows="4"></textarea></label>
      <label class="check"><input type="checkbox" name="consent" value="yes" required /><span>I agree to be contacted by email about my G.O.D. Coach setup and understand I can opt out any time.</span></label>
      <div><button class={godCoach.payUrl ? 'btn btn-secondary' : 'btn btn-primary'} type="submit">{godCoach.payUrl ? 'Send my goal' : 'Request my setup'}</button></div>
      <p class="small"><a href="/privacy/">Privacy policy</a> &nbsp;·&nbsp; <a href="/terms/">Terms</a></p>
    </form>
  </div></section>
</Base>

<style>
  .stack-photos{position:relative;aspect-ratio:1/1;max-width:560px;width:100%;justify-self:center}
  .sp{position:absolute;margin:0;border-radius:14px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.45);border:1px solid rgba(143,208,201,.35);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
  .sp img{width:100%;height:100%;object-fit:cover;display:block}
  .sp.main{inset:4% 14% 6% 14%;z-index:2;animation:float 9s ease-in-out infinite}
  .sp.a{width:52%;aspect-ratio:16/10;left:-4%;top:-2%;z-index:3;transform:rotate(-6deg);animation:float 11s ease-in-out -3s infinite}
  .sp.b{width:34%;aspect-ratio:3/4;right:-2%;bottom:0;z-index:3;transform:rotate(5deg);animation:float 10s ease-in-out -6s infinite}
  .stack-photos:hover .sp.a{transform:rotate(-2deg) translate(-8px,-8px)}
  .stack-photos:hover .sp.b{transform:rotate(2deg) translate(8px,8px)}
  @keyframes float{50%{translate:0 -10px}}
  .mode{padding:0;overflow:hidden;border-top:4px solid var(--c)}
  .mode>:not(.mode-img){margin-left:24px;margin-right:24px}
  .mode>:last-child{margin-bottom:24px}
  .mode-img{aspect-ratio:16/10;overflow:hidden}
  .mode-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s}
  .mode:hover .mode-img img{transform:scale(1.06)}
  .mode .eyebrow{color:var(--c)}
  @media(prefers-reduced-motion:reduce){.sp{animation:none}}
  .price-row{display:flex;align-items:baseline;gap:12px}
  .price{font:500 3rem var(--serif);color:#FFB4A8;line-height:1}
  .price-note{color:#CDE7E4;font-size:15px;letter-spacing:.04em}
  .steps{list-style:none;padding:0;margin:0}
  .steps .num{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--primary);color:#fff;font-weight:600}
</style>
