---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Application received | Marquis Harmon" description="Your mindset coaching application has been received." noindex>
  <section class="section mind"><NeuralCanvas /><div class="wrap stack g22" style="max-width:640px">
    <span class="eyebrow">Application received</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Thank you.</h1>
    <p class="lede">I review every application personally and will reply within 24-48 hours. If your situation is urgent or you are in crisis, please call or text 988 or call 911.</p>
    <div><a class="btn btn-secondary" href="/mindset-coaching/">Back to Mindset Coaching</a></div>
  </div></section>
</Base>
