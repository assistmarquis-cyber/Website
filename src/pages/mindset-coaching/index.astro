---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
import { ph } from '../../data/ph';
import { patternAudit, patternAuditHref } from '../../data/site';
import Snapshot from '../../components/Snapshot.astro';
import portrait from '../../assets/portrait.jpg';
const steps = [
  ['Listen', 'We start with what is hardest right now, in your business, money, family, or thinking. You get a space you trust to say it out loud.'],
  ['Name the patterns', 'We identify the impulses and instincts running your decisions and assess which ones serve you.'],
  ['Prototype', 'I turn what I heard into a basic first solution, fast, so you are testing instead of waiting.'],
  ['Act', 'You build the habit of catching an impulse and acting in the moment, with me as your accountability partner.'],
];
const offers = [
  ['Pattern Audit', 'One 60 to 90 minute session plus a written action map'],
  ['Mindset Sprint', 'Six weeks of weekly sessions and accountability check-ins'],
  ['Mindset Retainer', 'Monthly sessions and ongoing accountability for Sprint graduates'],
];
const faq = [
  ['Who is this for?', 'Founders, executives, and creators who are under pressure and want to act with more clarity and speed.'],
  ['How does the Pattern Audit work?', `You pay ${patternAudit.price} to book. You pick a time on my calendar right after you pay, then we meet for 60 to 90 minutes and you leave with a written action map.`],
  ['What happens after I apply?', 'I review every application personally and reply within 24-48 hours to schedule your paid discovery call or Pattern Audit.'],
  ['Is it confidential?', 'Yes, within the limits described in the coaching agreement, which you will see before we begin.'],
  ['Do you guarantee results?', 'No. I commit to showing up fully and holding you accountable. Results depend on the action you take.'],
];
---
<Base title="Mindset Coaching | Marquis Harmon" description="Mindset coaching and accountability for founders, creators, and leaders under pressure. Spot your patterns, trust your instinct, and act fast.">
  <section class="section mind"><NeuralCanvas />
    <div class="wrap stack g22" style="max-width:820px">
      <span class="eyebrow">Mindset coaching</span>
      <h1 style="color:#fff;font-size:clamp(2.4rem,5.5vw,4rem)">Know your voice. Trust your instinct. Act fast.</h1>
      <p class="lede" style="color:#DCCFBF">Mindset coaching and accountability for people carrying real pressure in business, money, and family.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={patternAuditHref}>Book a Pattern Audit, {patternAudit.price}</a>
        <a class="btn btn-secondary" href="#how">See how it works</a>
      </div>
    </div>
  </section>

  <section class="section" aria-label="The challenge">
    <div class="wrap split">
      <div class="stack g16"><span class="eyebrow">The challenge</span><h2>You know what you should do. Something keeps getting in the way.</h2></div>
      <div class="pain">
        <div><span class="n">01</span><div><h3>Pressure shrinks your view</h3><p>When stakes are high, you see only what you want most, and sometimes that costs you.</p></div></div>
        <div><span class="n">02</span><div><h3>The same patterns repeat</h3><p>The impulses driving your decisions are invisible until someone helps you name them.</p></div></div>
        <div><span class="n">03</span><div><h3>Insight without action fades</h3><p>Clarity is only useful if you act on it while it is still fresh.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section mint" id="how">
    <div class="wrap">
      <div class="head"><h2>How it works</h2></div>
      <div class="grid c4 model">
        {steps.map(([h, p], i) => <div><span class="n">0{i + 1}</span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><h2>Ways to work together</h2></div>
      <div class="grid c3">
        {offers.map(([t, d], i) => i === 0
          ? <article class="card"><h3>{t}</h3><p class="offer-price">{patternAudit.price}</p><p>{d}</p><a class="price-link" href={patternAuditHref}>Book it for {patternAudit.price} →</a></article>
          : <article class="card"><h3>{t}</h3><p>{d}</p><a class="price-link" href="#apply">Inquire for pricing →</a></article>)}
      </div>
      <p style="margin-top:28px">Looking for a deeper, ground-up engagement for senior leaders? See the <a href="/executive-coaching/">7 Layer Strategy</a>.</p>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap split">
      <div class="stack g16"><h2>Why work with Marquis</h2></div>
      <p>I know the loop of survival mode firsthand. For years I could only see what I wanted most, even when it meant losing. Learning to tell the voice of survival from the voice of instinct changed how I lead, and it is the work I now do with others. I have shared that approach on stages including the United Nations, COP22, and Hive at Harvard Business School.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stack g16"><h2>What this is, and is not</h2></div>
      <p>Mindset coaching is accountability and action-focused work. It is not therapy, counseling, or medical care, and I do not diagnose or treat any condition. It works well alongside a therapist, and I will tell you honestly if I think you need support beyond coaching.</p>
    </div>
  </section>

  <section class="section mint">
    <div class="wrap">
      <div class="head"><h2>FAQ</h2></div>
      <div class="grid c2">
        {faq.map(([q, a]) => <div class="card"><h3>{q}</h3><p set:html={ph(a)} /></div>)}
      </div>
    </div>
  </section>

  <section class="section" id="apply">
    <div class="wrap split">
      <div class="stack g22">
        <h2>Ready to act on what you already know?</h2>
        <p>Start with a {patternAudit.price} Pattern Audit, or apply below and tell me where you are.</p>
        {patternAudit.payUrl && <div><a class="btn btn-primary" href={patternAuditHref}>Book a Pattern Audit, {patternAudit.price}</a></div>}
        <Snapshot src={portrait} alt="Marquis Harmon seated, chin in hand, listening" cap="This is how I listen. Tell me what's in the way." pos="center 35%" />
      </div>
      <div class="card">
        <p class="notice" role="note"><b>If you are in crisis or thinking about harming yourself, call or text 988 or call 911. This form is not monitored in real time.</b></p>
        <form class="form" name="mindset-application" method="POST" action="/mindset-coaching/thanks/" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="mindset-application" />
          <p class="hp"><label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="row">
            <label>Full name<input type="text" name="name" required autocomplete="name" /></label>
            <label>Email<input type="email" name="email" required autocomplete="email" /></label>
          </div>
          <label>Business or role<input type="text" name="role" required /></label>
          <label>What pressure are you under right now? (Please do not include medical details.)<textarea name="pressure" rows="4" required></textarea></label>
          <label>What have you already tried?<textarea name="tried" rows="3"></textarea></label>
          <label>What would you like to change in the next 90 days?<textarea name="change_90_days" rows="3" required></textarea></label>
          <div class="row">
            <label>When do you want to start?
              <select name="start" required><option value="">Choose one</option><option>This month</option><option>Within 3 months</option><option>Just exploring</option></select>
            </label>
            <label>How did you hear about me?<input type="text" name="referral" /></label>
          </div>
          <label class="check"><input type="checkbox" name="consent" value="yes" required /><span>I agree to be contacted by email about my application and understand I can opt out any time.</span></label>
          <div><button class="btn btn-primary" type="submit">Submit application</button></div>
          <p class="small"><a href="/privacy/">Privacy policy</a> &nbsp;·&nbsp; <a href="/terms/">Terms</a></p>
        </form>
      </div>
    </div>
  </section>

</Base>
