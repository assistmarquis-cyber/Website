---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
import Snapshot from '../../components/Snapshot.astro';
import selfie from '../../assets/portal/workshop-room-chicago.jpg';
---
<Base title="Pattern Audit booked | Marquis Harmon" description="Your Pattern Audit is paid and booked." noindex>
  <section class="section mind"><NeuralCanvas /><div class="wrap split" style="align-items:center"><div class="stack g22" style="max-width:640px">
    <span class="eyebrow">Pattern Audit booked</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">You're in. Thank you.</h1>
    <p class="lede">Your payment went through and a receipt is on its way. I'll email you within 24-48 hours to set our time. Before we meet, think about the one pressure you most want to move.</p>
    <p class="lede">If your situation is urgent or you are in crisis, please call or text 988 or call 911.</p>
    <div><a class="btn btn-secondary" href="/mindset-coaching/">Back to Mindset Coaching</a></div>
  </div>
    <Snapshot src={selfie} alt="Marquis Harmon taking a selfie in front of a full workshop room in Chicago" cap="Glad you're here. Talk soon." tilt={2} pos="center 80%" eager />
  </div></section>
</Base>
