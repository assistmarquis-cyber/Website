---
import Base from '../../layouts/Base.astro';
import { concepts } from '../../data/portal';
const areas = [...new Set(concepts.map((c) => c.area))];
---
<Base title="Client Portal | Marquis Harmon" description="What Marquis is building right now, for clients." noindex>
  <section class="section mint"><div class="wrap stack g22" style="max-width:820px">
    <span class="eyebrow">Client portal</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">What I'm building right now.</h1>
    <p class="lede">You're seeing the concepts I'm deep in before they're public: Web3 and AI, creativity, and value creation. Read, react, and bring your questions to our next session.</p>
  </div></section>
  {areas.map((area) => (
    <section class="section" style="padding-top:56px;padding-bottom:24px"><div class="wrap">
      <h2 style="margin-bottom:28px">{area}</h2>
      <div class="grid c2">
        {concepts.filter((c) => c.area === area).map((c) => (
          <article class="card">
            <span class="eyebrow" style="font-size:11px">{c.status}</span>
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <div class="stack g16" style="border-top:1px solid var(--border);padding-top:14px">
              <strong style="font-size:14px;color:var(--text)">Bring to our next session</strong>
              {c.questions.map((q) => <p style="font-size:15px;color:var(--muted)">{q}</p>)}
            </div>
          </article>
        ))}
      </div>
    </div></section>
  ))}
  <section class="section"><div class="wrap stack g16" style="max-width:640px">
    <h2 style="font-size:clamp(1.6rem,3.2vw,2.3rem)">Want in on one of these?</h2>
    <p>Reply to any of my emails or write to <a href="mailto:book@bigpicturearchitect.com">book@bigpicturearchitect.com</a> and tell me which concept caught you.</p>
  </div></section>
</Base>
