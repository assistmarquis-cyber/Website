---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Audit received | Marquis Harmon" description="Your Claude Audit has been received." noindex>
  <section class="section mind"><NeuralCanvas /><div class="wrap stack g22" style="max-width:640px">
    <span class="eyebrow">Claude Audit received</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Got it. See you in Session 1.</h1>
    <p class="lede">I read every audit before we meet, so we can spend our time building. Bring the one task you named, and we will finish it together.</p>
  </div></section>
</Base>
