---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Application received | Marquis Harmon" description="Your Claude coaching application has been received." noindex>
  <section class="section mind"><NeuralCanvas /><div class="wrap stack g22" style="max-width:640px">
    <span class="eyebrow">Application received</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Thank you.</h1>
    <p class="lede">I review every application personally and will reply within 24 to 48 hours to set up your fit call.</p>
    <div><a class="btn btn-secondary" href="/claude-coaching/">Back to Claude Coaching</a></div>
  </div></section>
</Base>
