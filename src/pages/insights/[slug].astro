---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
import { published as insights } from '../../data/insights';
import { ids } from '../../data/seo';
import { ph } from '../../data/ph';
export function getStaticPaths() { return insights.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props;
const url = `https://bigpicturearchitect.com/insights/${a.slug}/`;
const others = insights.filter((x) => x.slug !== a.slug).slice(0, 3);
const strip = (s: string) => s.replace(/^(## |- )/, '');
const schema = [{
  '@type': 'Article', '@id': `${url}#article`, url, headline: a.title, description: a.dek,
  datePublished: a.date, dateModified: a.date, inLanguage: 'en-US', image: 'https://bigpicturearchitect.com/og.jpg',
  author: { '@id': ids.person }, publisher: { '@id': ids.org }, mainEntityOfPage: url,
  articleBody: a.body.map(strip).join('\n\n'),
}];
// Group consecutive '- ' lines into one list.
const blocks: { kind: 'p' | 'h' | 'ul'; items: string[] }[] = [];
for (const b of a.body) {
  if (b.startsWith('- ')) {
    const last = blocks[blocks.length - 1];
    if (last?.kind === 'ul') last.items.push(b.slice(2)); else blocks.push({ kind: 'ul', items: [b.slice(2)] });
  } else if (b.startsWith('## ')) blocks.push({ kind: 'h', items: [b.slice(3)] });
  else blocks.push({ kind: 'p', items: [b] });
}
const nice = new Date(a.date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base schema={schema} title={`${a.title} | Marquis Harmon`} description={`${a.dek} An insight by Marquis Harmon, The Big Picture Arkitect.`}>
  <section class="section mind"><NeuralCanvas />
    <div class="wrap stack g22" style="max-width:820px">
      <a class="eyebrow" href="/insights/" style="text-decoration:none">Insights</a>
      <h1 style="color:#fff;font-size:clamp(2rem,4.6vw,3.2rem)">{a.title}</h1>
      <p class="lede" style="color:#DCCFBF">{a.dek}</p>
      <p style="color:#B9C9C6;font-size:15px">By <a href="/about/" style="color:#8FD0C9">Marquis Harmon</a> · {nice}</p>
    </div>
  </section>
  <section class="section">
    <article class="wrap stack g22 legal" style="max-width:720px">
      {blocks.map((b) => b.kind === 'h' ? <h2 style="font-size:clamp(1.4rem,3vw,1.9rem)">{b.items[0]}</h2>
        : b.kind === 'ul' ? <ul>{b.items.map((i) => <li set:html={ph(i)} />)}</ul>
        : <p set:html={ph(b.items[0])} />)}
      <div><a class="btn btn-primary" href={a.cta[0]}>{a.cta[1]}</a></div>
    </article>
  </section>
  <section class="section mint">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Keep reading</span><h2>More insights</h2></div>
      <div class="grid c3">
        {others.map((o) => <article class="card"><h3>{o.title}</h3><p>{o.dek}</p><a class="price-link" href={`/insights/${o.slug}/`}>Read it →</a></article>)}
      </div>
      <p style="margin-top:24px"><a class="link-arrow" href="/insights/">All insights →</a></p>
    </div>
  </section>
</Base>
