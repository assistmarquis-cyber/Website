---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you | Marquis Harmon" description="Your request has been received." noindex>
  <section class="section"><div class="wrap stack g22" style="max-width:640px">
    <span class="eyebrow">Request received</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Thank you.</h1>
    <p class="lede">Your inquiry is in. Our team will be in touch with availability and next steps.</p>
    <div><a class="btn btn-secondary" href="/">Back to home</a></div>
  </div></section>
</Base>
