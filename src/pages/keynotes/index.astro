---
import { service } from '../../data/seo';
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
import NextStage from '../../components/NextStage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { purpose } from '../../data/gallery';
import { keynotes, site } from '../../data/site';
const schema = [service({ name: 'Keynote speaking by Marquis Harmon', serviceType: 'Keynote speaking', url: 'https://bigpicturearchitect.com/keynotes/', description: 'Story-driven keynotes on leadership and business development, AI thought management, and creating social impact, for conferences, nonprofit and impact organizations, and corporate events.' })];
---
<Base schema={schema} title="Keynote Speaker on Leadership, AI & Social Impact | Marquis Harmon" description="Book Marquis Harmon, keynote speaker on leadership, AI and social impact, for conferences, nonprofit and impact organizations and corporate events. He has spoken at the United Nations, COP22 and Harvard Business School.">
  <section class="section mind"><NeuralCanvas />
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Keynotes</span>
        <h1 style="font-size:clamp(2.2rem,5vw,3.8rem)">Three talks. One goal: a picture your people can act on.</h1>
        <p class="lede">Story-driven keynotes for leadership summits, all-hands and industry stages.</p>
        <div class="btn-row"><a class="btn btn-primary" href="/contact/">Request availability</a><a class="btn btn-secondary" href={site.oneSheet}>Download speaker one-sheet</a></div>
      </div>
      <div class="grid c3">
        {keynotes.map((k) => (
          <article class="card">
            <span class="eyebrow">{k.topic}</span>
            <h3>{k.title}</h3>
            <p>{k.summary}</p>
            <a class="link-arrow" href={`/keynotes/${k.slug}/`}>About this keynote →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <NextStage />
  <CtaBand photo={purpose} title="Planning a summit, all-hands or conference?" text="Tell us about your audience and objectives and we'll recommend the right talk." />
</Base>
