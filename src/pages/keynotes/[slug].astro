---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { purpose } from '../../data/gallery';
import { keynotes, site } from '../../data/site';
export function getStaticPaths() { return keynotes.map((k) => ({ params: { slug: k.slug }, props: { k } })); }
const { k } = Astro.props;
const others = keynotes.filter((x) => x.slug !== k.slug);
---
<Base title={`${k.seo} | Marquis Harmon`} description={`${k.summary} A keynote by Marquis Harmon, The Big Picture Arkitect.`}>
  <section class="section">
    <div class="wrap split even">
      <div class="stack g22">
        <p class="crumbs"><a href="/keynotes/">Keynotes</a> / {k.topic}</p>
        <span class="eyebrow">{k.topic}</span>
        <h1 style="font-size:clamp(2.4rem,5.5vw,4rem)">{k.title}</h1>
        <p class="lede">{k.summary}</p>
        <div class="btn-row"><a class="btn btn-primary" href="/contact/">Request availability</a><a class="btn btn-secondary" href={site.oneSheet}>Download speaker one-sheet</a></div>
      </div>
      <div class="stack g28">
        {k.description && <div class="stack g16"><h3>About the talk</h3><p>{k.description}</p></div>}
        {k.takeaways.length > 0 && <div class="stack g16"><h3>What your audience takes away</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px">{k.takeaways.map((t) => <li>{t}</li>)}</ul>
        </div>}
        <div class="ideal" style="color:var(--muted);font-size:14px"><strong>Ideal for</strong> Leadership summits · All-hands · Conferences</div>
      </div>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <div class="head"><h2 style="font-size:1.8rem">More keynotes</h2></div>
    <div class="grid c2">{others.map((o) => <article class="card"><span class="eyebrow">{o.topic}</span><h3>{o.title}</h3><a class="link-arrow" href={`/keynotes/${o.slug}/`}>About this keynote →</a></article>)}</div>
  </div></section>
  <CtaBand photo={purpose} title="Bring this talk to your stage." text="Share your date, audience and objectives and we'll respond with availability." />
</Base>
