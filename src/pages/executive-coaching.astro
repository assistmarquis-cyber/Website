---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { layers } from '../data/site';
---
<Base title="Executive Coaching: The 7 Layer Strategy | Marquis Harmon" description="The 7 Layer Strategy is a ground-up executive coaching engagement for senior leaders, from personal identity and presence to systems, teams and sustained momentum.">
  <section class="section dark">
    <div class="wrap split">
      <div class="stack g22">
        <span class="eyebrow">Executive coaching</span>
        <h1 style="color:#fff;font-size:clamp(2.4rem,5.5vw,4rem)">The 7 Layer Strategy</h1>
        <p>A ground-up approach. Each layer builds on the one beneath it, so leaders move from who they are to what they build, and the momentum holds.</p>
        <p>Delivered one-to-one for senior leaders or as a program for leadership teams. The names and shape of the layers are public; the methods stay private to the engagement.</p>
        <div><a class="btn btn-primary" href="/contact/">Discuss a coaching engagement</a></div>
      </div>
      <div class="stairs">
        <div class="end"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8FD0C9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>Finish</div>
        {[...layers].reverse().map(([t, d], i) => (
          <div class="step"><span class="n">0{7 - i}</span><div><b>{t}</b><span class="d">{d}</span></div></div>
        ))}
        <div class="end">Start · Ground up</div>
      </div>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <div class="head"><span class="eyebrow">Who it's for</span><h2>Senior leaders at a turning point.</h2></div>
    <div class="grid c3">
      <div class="card"><h3>C-suite</h3><p>Leaders carrying a transformation who need their story, presence and team aligned.</p></div>
      <div class="card"><h3>New executives</h3><p>Leaders stepping into a bigger role who need to establish trust and momentum fast.</p></div>
      <div class="card"><h3>High-stakes talks</h3><p>Leaders preparing for a defining moment in front of a board, a market or a company.</p></div>
    </div>
  </div></section>
  <CtaBand title="Ready to start from the ground up?" text="Tell us about the leader and the moment, and we'll recommend the right engagement." />
</Base>
