---
import Base from '../layouts/Base.astro';
---
<Base bare noindex title="The Room: UX design prototype | Marquis Harmon" description="A clickable design prototype of The Room: every screen, state and interaction, with the design system behind it.">
  <div class="ux" id="ux">
    <aside class="uxnav" aria-label="Screens">
      <a class="back" href="/partner/">Open the working app</a>
      <h1>The Room</h1>
      <p class="sub">Interactive UX design. Click through the phone, or jump to any screen.</p>
      <div id="map"></div>
      <div class="tog" role="group" aria-label="Frame">
        <button data-f="phone" aria-pressed="true">Phone</button>
        <button data-f="desk" aria-pressed="false">Desktop</button>
        <button data-f="motion" aria-pressed="true" title="Breathing glow">Glow on</button>
      </div>
    </aside>

    <section class="canvas">
      <div class="device" id="device" data-f="phone">
        <div class="uxbg" id="orb"></div>
        <div class="uxtop"><span class="mk">Marquis Harmon</span><span class="pg" id="pg"><i></i></span></div>
        <div class="scr" id="scr" aria-live="polite"></div>
        <div class="ft">Stays on this device. Nothing sent.</div>
      </div>
    </section>

    <aside class="notes" id="notes" aria-label="Design notes"></aside>
  </div>
</Base>

<style is:global>
  html, body { background: #0A1E1D; }
  .ux { --ink:#F4EEE3; --soft:#B9CCC8; --faint:#7F9894; --line:rgba(244,238,227,.14); --glow:#E8B76A; --card:rgba(244,238,227,.055);
    display: grid; grid-template-columns: 250px 1fr 300px; min-height: 100svh; color: var(--ink); font-family: var(--sans);
    background: #0A1E1D; }
  .ux a { color: inherit; }
  .uxnav, .notes { padding: 24px 20px; border-right: 1px solid var(--line); overflow-y: auto; max-height: 100svh; position: sticky; top: 0; }
  .notes { border: 0; border-left: 1px solid var(--line); }
  .uxnav h1 { font: 500 28px var(--serif); margin: 18px 0 6px; color: var(--ink); }
  .sub { color: var(--faint); font-size: 14px; line-height: 1.5; margin: 0 0 20px; }
  .back { font-size: 13px; color: var(--glow); text-decoration: none; }
  .grp { font: 600 11px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--faint); margin: 18px 0 6px; }
  .nb { display: flex; gap: 10px; align-items: center; width: 100%; text-align: left; background: none; border: 0; border-radius: 10px; color: var(--soft); font: 14px var(--sans); padding: 8px 10px; cursor: pointer; }
  .nb:hover { background: var(--card); color: var(--ink); }
  .nb[aria-current="true"] { background: rgba(232,183,106,.14); color: var(--ink); }
  .nb b { font: 500 12px var(--serif); color: var(--glow); min-width: 18px; }
  .tog { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .tog button { background: var(--card); border: 1px solid var(--line); color: var(--soft); border-radius: 999px; padding: 6px 12px; font: 13px var(--sans); cursor: pointer; }
  .tog button[aria-pressed="true"] { border-color: var(--glow); color: var(--ink); }
  .nb:focus-visible, .tog button:focus-visible, .ux .b:focus-visible, .ux .ch:focus-visible, .ux textarea:focus-visible, .back:focus-visible { outline: 2px solid var(--glow); outline-offset: 2px; }

  .canvas { display: grid; place-items: center; padding: 28px 16px; background: radial-gradient(60% 50% at 50% 40%, #12383661, transparent); }
  .device { position: relative; overflow: hidden; width: 390px; height: 780px; max-height: calc(100svh - 56px); border-radius: 38px; border: 1px solid rgba(244,238,227,.22);
    background: linear-gradient(180deg, #1D4B49, #0F2B2A 55%, #0A1E1D); box-shadow: 0 30px 80px rgba(0,0,0,.5); display: flex; flex-direction: column; transition: width .4s, height .4s, border-radius .4s; }
  .device[data-f="desk"] { width: min(860px, 100%); height: 620px; border-radius: 16px; }
  .uxbg { position: absolute; left: 50%; top: 35%; width: 80%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle at 40% 35%, rgba(232,183,106,.3), rgba(27,102,99,.18) 45%, transparent 70%); filter: blur(26px); animation: br 9s ease-in-out infinite; }
  .ux[data-motion="off"] .uxbg, .ux[data-motion="off"] .fd { animation: none; }
  @keyframes br { 0%,100% { transform: scale(.92); opacity: .75 } 50% { transform: scale(1.08); opacity: 1 } }
  .uxtop, .scr, .ft { position: relative; z-index: 1; }
  .uxtop { display: flex; justify-content: space-between; align-items: center; padding: 22px 22px 6px; }
  .mk { font: 14px var(--serif); color: var(--soft); }
  .pg { width: 70px; height: 3px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .pg i { display: block; height: 100%; width: 0; background: var(--glow); transition: width .5s; }
  .scr { flex: 1; overflow-y: auto; padding: 14px 24px 18px; display: flex; flex-direction: column; justify-content: center; }
  .device[data-f="desk"] .scr { padding: 14px 15%; }
  .ft { text-align: center; font-size: 11px; color: var(--faint); padding: 8px 12px 14px; }
  .fd { animation: ri .5s ease both; }
  @keyframes ri { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: none } }
  .ux .ey { font-size: 11px; letter-spacing: .15em; text-transform: uppercase; color: var(--glow); margin: 0 0 12px; }
  .ux h2 { font: 500 28px/1.15 var(--serif); margin: 0 0 12px; color: var(--ink); }
  .device[data-f="desk"] h2 { font-size: 34px; }
  .ux .p { color: var(--soft); font-size: 15px; line-height: 1.55; margin: 0 0 12px; }
  .ux .h { color: var(--faint); font-size: 13.5px; line-height: 1.5; margin: 0 0 14px; }
  .ux .uxrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
  .ux .b { background: var(--glow); color: #2A1D14; border: 0; border-radius: 999px; padding: 12px 22px; font: 600 15px var(--sans); cursor: pointer; }
  .ux .b.a { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .ux .g { background: none; border: 0; color: var(--faint); font: 13px var(--sans); cursor: pointer; padding: 8px; }
  .ux textarea { width: 100%; min-height: 110px; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 14px; padding: 14px; font: 16px/1.5 var(--sans); resize: none; }
  .ux .chs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .ux .ch { background: var(--card); color: var(--soft); border: 1px solid var(--line); border-radius: 999px; padding: 7px 12px; font: 13px var(--sans); cursor: pointer; }
  .ux .ch[aria-pressed="true"] { background: rgba(232,183,106,.16); border-color: var(--glow); color: var(--ink); }
  .ux .echo { border-left: 2px solid var(--glow); padding: 2px 0 2px 14px; margin-bottom: 14px; }
  .ux .echo q { display: block; font: 18px/1.4 var(--serif); }
  .ux .echo .p { margin-top: 10px; }
  .ux .how div { display: flex; gap: 10px; color: var(--soft); font-size: 14px; margin: 6px 0; }
  .ux .how b { color: var(--glow); font-family: var(--serif); font-weight: 500; }
  .ux .sheet { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px; margin-bottom: 12px; }
  .ux .sheet b { color: var(--ink); }
  .ux .osc { background: #FBF8F3; color: #2A1D14; border-radius: 16px; padding: 18px; }
  .ux .osc h2 { color: #124A48; font-size: 24px; }
  .ux .osc section { border-top: 1px solid #E6DDD0; padding: 10px 0; }
  .ux .osc h4 { font: 600 10px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: #B8322A; margin: 0 0 4px; }
  .ux .osc p { font: 15px/1.45 var(--serif); margin: 0; color: #2A1D14; }
  .ux .osc .tg { display: flex; gap: 6px; flex-wrap: wrap; }
  .ux .osc .tg span { background: #D6EBE8; color: #124A48; border-radius: 999px; padding: 4px 10px; font-size: 13px; }
  .ux .hot { outline: 2px dashed var(--glow); outline-offset: 3px; border-radius: 12px; }
  .ux .pulse { animation: pu 1.8s ease-in-out infinite; }
  @keyframes pu { 50% { box-shadow: 0 0 0 6px rgba(232,183,106,.22) } }

  .notes h3 { font: 600 11px var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--glow); margin: 0 0 8px; }
  .notes h2 { font: 500 22px var(--serif); margin: 0 0 10px; color: var(--ink); }
  .notes p, .notes li { color: var(--soft); font-size: 14px; line-height: 1.55; }
  .notes ul { padding-left: 18px; margin: 0 0 16px; }
  .sw { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin: 8px 0 16px; }
  .sw i { height: 34px; border-radius: 8px; border: 1px solid var(--line); display: block; }
  .sw small { display: block; font-size: 10px; color: var(--faint); margin-top: 3px; }
  .notes code { background: var(--card); padding: 1px 6px; border-radius: 6px; font-size: 12px; }

  @media (max-width: 1000px) {
    .ux { grid-template-columns: 1fr; }
    .uxnav, .notes { position: static; max-height: none; border: 0; border-bottom: 1px solid var(--line); }
    .device { max-height: none; height: 720px; width: min(390px, 100%); }
    .tog button[data-f="desk"] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .uxbg, .fd { animation: none; } }
</style>

<script>
  // Every screen is data: group, label, progress (0-1), notes, and a render function.
  // State is demo-only and in memory; nothing is stored or sent.
  type Scr = { id: string; g: string; n: string; p: number; notes: string; html: () => string; wire?: (go: (id: string) => void) => void };
  const demo = {
    work: 'People call me when an idea is messy and they need it turned into something they can act on.',
    gifts: ['Design thinking', 'Building rapport', 'Motivating people'],
  };
  const e = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  let picks = [...demo.gifts];

  const q = (ey: string, h: string, hint: string, ph: string, val: string, next: string, prev?: string) => `
    <div class="fd"><p class="ey">${ey}</p><h2>${h}</h2><p class="h">${hint}</p>
    <textarea aria-label="Your answer" placeholder="${ph}">${val}</textarea>
    <div class="uxrow"><button class="b" data-go="${next}">Continue</button>${prev ? `<button class="b a" data-go="${prev}">Back</button>` : ''}<button class="g" data-go="${next}">Skip for now</button></div></div>`;

  const S: Scr[] = [
    { id: 'welcome', g: 'Arrive', n: 'Welcome', p: 0,
      notes: `<h3>Job of this screen</h3><p>Lower the guard. Say what this is, what it isn't, and how long it takes, in that order.</p><ul><li>One primary action: Begin.</li><li>Privacy is stated in plain words, twice (here and footer).</li><li>No logo wall, no feature list, no sign-up.</li></ul>`,
      html: () => `<div class="fd"><p class="ey">A thinking partner</p><h2>Say it out loud. We'll make sense of it together.</h2>
        <p class="p">No feed, no streaks, no account. Eight questions, one at a time, and you leave with a one-page operating system built from your own life's work.</p>
        <div class="how"><div><b>1</b><span>I ask. You answer in your own words.</span></div><div><b>2</b><span>I reflect back what I heard.</span></div><div><b>3</b><span>You leave with a page you can live by.</span></div></div>
        <div class="uxrow"><button class="b pulse" data-go="q1">Begin</button><button class="g" data-go="privacy">How is my data handled?</button></div></div>` },
    { id: 'privacy', g: 'Arrive', n: 'Privacy sheet', p: 0,
      notes: `<h3>Job of this screen</h3><p>Answer the "is this watching me" worry before it is asked. This is the trust move for people who feel uneasy about tech.</p><ul><li>Plain sentences, no legal tone.</li><li>Shows the one control that matters: erase everything.</li></ul>`,
      html: () => `<div class="fd"><p class="ey">Your data</p><h2>Nothing leaves this device.</h2>
        <div class="sheet"><p class="p"><b>Where it lives:</b> in this browser only.</p><p class="p"><b>Who sees it:</b> you. No account, no analytics on your answers.</p><p class="p" style="margin:0"><b>Control:</b> "Start over" erases everything, any time.</p></div>
        <div class="uxrow"><button class="b" data-go="welcome">Got it</button></div></div>` },
    { id: 'q1', g: 'Ask', n: 'Q1 · Life\'s work', p: .12,
      notes: `<h3>Pattern</h3><p>One question, one text box, one big button. The hint lowers the bar ("tell it the way you would to a friend").</p><ul><li>Answers autosave. Back never loses text.</li><li>Skip is always available, never hidden.</li></ul>`,
      html: () => q('1 of 8 · Life\'s work', 'What have you done for years that people keep coming to you for?', 'Not your job title. The thing people bring you, even when it isn\'t your job.', 'People call me when...', e(demo.work), 'r1') },
    { id: 'r1', g: 'Ask', n: 'Reflection', p: .15,
      notes: `<h3>The "what I heard" beat</h3><p>After each answer the person sees their own words back, with one line from the method. This is what makes it feel like a partner, not a form.</p><ul><li>Quote is verbatim, trimmed to 150 characters.</li><li>"Say it differently" returns to the same question with text intact.</li></ul>`,
      html: () => `<div class="fd"><p class="ey">What I heard</p><div class="echo"><q>“${e(demo.work)}”</q><p class="p">This is your specific intelligence. A tool can be general. This part is only yours, so everything else gets built around it.</p></div>
        <div class="uxrow"><button class="b" data-go="q3">Next question</button><button class="b a" data-go="q1">Say it differently</button></div></div>` },
    { id: 'q3', g: 'Ask', n: 'Q3 · Gifts (chips)', p: .37,
      notes: `<h3>Variation</h3><p>Chips make one answer easy for people who freeze on a blank page. Pick up to three. A free-text box stays underneath.</p><ul><li>Pressed state uses the glow color and a border, not color alone.</li><li>Cap of three keeps answers honest.</li></ul>`,
      html: () => { const all = ['Design thinking', 'Building rapport', 'Motivating people', 'Seeing patterns', 'Calm in a crisis', 'Teaching', 'Making things from nothing', 'Connecting people', 'Strategy', 'Listening'];
        return `<div class="fd"><p class="ey">3 of 8 · Gifts</p><h2>Which of these are actually yours?</h2><p class="h">Pick up to three. Honest, not modest and not flattering.</p>
        <div class="chs">${all.map((c) => `<button class="ch" data-pick="${c}" aria-pressed="${picks.includes(c)}">${c}</button>`).join('')}</div>
        <div class="uxrow"><button class="b" data-go="q5">Continue</button><button class="b a" data-go="r1">Back</button></div></div>`; } },
    { id: 'q5', g: 'Ask', n: 'Q5 · Two voices', p: .62,
      notes: `<h3>Signature question</h3><p>The survival voice vs instinct voice is Marquis's core idea. It gets a two-part prompt and the most space.</p><ul><li>Hint defines both voices in one line each.</li><li>Reflection stresses naming, not stopping.</li></ul>`,
      html: () => q('5 of 8 · Two voices', 'Think of the last time pressure shrank your view. What did your survival voice say, and what did your instinct say?', 'Survival grabs for what you want most, right now. Instinct is quieter and usually earlier.', 'Survival said... Instinct said...', 'Survival said close it at any cost. Instinct said slow down.', 'q8', 'q3') },
    { id: 'q8', g: 'Ask', n: 'Q8 · Next move', p: .9,
      notes: `<h3>Why it ends here</h3><p>The last question forces a small action in 24 hours and a named person. Insight without action fades, so the flow ends on a commitment, not a summary.</p>`,
      html: () => q('8 of 8 · Execution', 'What is the smallest real move you can make in 24 hours, and who will know whether you did it?', 'Small enough to do today. Someone specific has to know.', 'By tomorrow I will...', 'Send the proposal by noon and tell my accountability partner.', 'build', 'q5') },
    { id: 'build', g: 'Result', n: 'Building', p: 1,
      notes: `<h3>A pause, on purpose</h3><p>A two-second breath before the result. It marks the moment and avoids a harsh jump. Skipped when reduced motion is on.</p>`,
      html: () => `<div class="fd" style="text-align:center"><p class="ey">Putting it together</p><h2>Reading what you told me.</h2><p class="p">Your words, in your order.</p><div class="uxrow" style="justify-content:center"><button class="b a" data-go="os">See it</button></div></div>`,
      wire: (go) => { const t = setTimeout(() => go('os'), 2200); (window as any).__t = t; } },
    { id: 'os', g: 'Result', n: 'My operating system', p: 1,
      notes: `<h3>The deliverable</h3><p>A light page on a dark room, so it reads as something to keep. Every line is editable in place, with a visible edit affordance.</p><ul><li>Order: specific intelligence, gifts, proof, identity, voices, rules, cut, next move.</li><li>Copy, download, print, revisit.</li><li>Printing hides everything but the page.</li></ul>`,
      html: () => `<div class="fd"><div class="osc"><h2>My operating system</h2>
        <section><h4>My specific intelligence</h4><p class="hot">${e(demo.work)}</p></section>
        <section><h4>My gifts</h4><div class="tg">${picks.map((g) => `<span>${g}</span>`).join('')}</div></section>
        <section><h4>Mindset: my two voices</h4><p>Survival said close it at any cost. Instinct said slow down.</p></section>
        <section><h4>Execution: my next move</h4><p>Send the proposal by noon and tell my accountability partner.</p></section></div>
        <div class="uxrow"><button class="b" data-go="share">Copy as text</button><button class="b a" data-go="checkin">Weekly check-in</button><button class="g" data-go="q1">Revisit questions</button></div></div>` },
    { id: 'share', g: 'Result', n: 'Copied confirmation', p: 1,
      notes: `<h3>Quiet feedback</h3><p>The button changes to "Copied". No toast, no confetti. Same for Download and Print.</p>`,
      html: () => `<div class="fd"><p class="ey">Done</p><h2>Copied.</h2><p class="p">Paste it into your notes, an email to yourself, or the first page of a notebook.</p><div class="uxrow"><button class="b" data-go="os">Back to my page</button></div></div>` },
    { id: 'checkin', g: 'Return', n: 'Weekly check-in', p: 1,
      notes: `<h3>Reason to come back</h3><p>Three honest questions, about two minutes, once a week. It uses the person's own rules from the page, so it grows with them. No streaks, no nudges, no notifications.</p>`,
      html: () => `<div class="fd"><p class="ey">This week</p><h2>Which voice ran the week?</h2><p class="h">Survival or instinct, and when? Then: which of your rules held, and what did you cut?</p>
        <textarea aria-label="Check-in" placeholder="Honestly, it was..."></textarea><div class="uxrow"><button class="b" data-go="log">Save this week</button><button class="b a" data-go="os">Back</button></div></div>` },
    { id: 'log', g: 'Return', n: 'Check-in history', p: 1,
      notes: `<h3>A record, not a score</h3><p>Entries are dated and kept in plain language. Nothing is graded. Patterns become visible over weeks, which is the point.</p>`,
      html: () => `<div class="fd"><p class="ey">Your weeks</p><h2>What you've noticed.</h2>
        <div class="sheet"><p class="p"><b>Oct 29</b> Survival ran Tuesday. I sent the proposal anyway, after sleeping on it.</p></div>
        <div class="sheet"><p class="p"><b>Oct 22</b> Rule held: no yes to calls the same day.</p></div>
        <div class="uxrow"><button class="b" data-go="human">Want a human in the room?</button><button class="b a" data-go="os">Back</button></div></div>` },
    { id: 'human', g: 'Return', n: 'Pattern Audit hand-off', p: 1,
      notes: `<h3>The only sell</h3><p>One soft offer, shown only after value is delivered, never in the flow. It connects the app to Marquis's paid work.</p>`,
      html: () => `<div class="fd"><p class="ey">Want a human in the room?</p><h2>Walk through it with Marquis.</h2><p class="p">A Pattern Audit is one session where you and Marquis go through this page and turn it into an action map.</p><div class="uxrow"><button class="b" data-go="os">See how it works</button><button class="b a" data-go="os">Not now</button></div></div>` },
    { id: 'reset', g: 'States', n: 'Start over (confirm)', p: 0,
      notes: `<h3>Safe exit</h3><p>Erase is clear and one step, with a plain confirmation. People trust tools they can leave.</p>`,
      html: () => `<div class="fd"><p class="ey">Start over</p><h2>Erase everything on this device?</h2><p class="p">This removes your answers, your page and your check-ins. It can't be undone.</p><div class="uxrow"><button class="b" data-go="welcome">Erase and start over</button><button class="b a" data-go="os">Keep it</button></div></div>` },
    { id: 'return', g: 'States', n: 'Returning visitor', p: 0,
      notes: `<h3>Welcome back</h3><p>If a page exists, the front door opens it. Revisiting the questions is secondary.</p>`,
      html: () => `<div class="fd"><p class="ey">Welcome back</p><h2>Your page is where you left it.</h2><div class="uxrow"><button class="b" data-go="os">Open my operating system</button><button class="b a" data-go="q1">Revisit the questions</button></div></div>` },
  ];

  const $ = (id: string) => document.getElementById(id)!;
  const ux = $('ux'), scr = $('scr'), notes = $('notes'), pg = $('pg').firstElementChild as HTMLElement;
  let cur = 'welcome';

  const systemNotes = `<h3>Design system</h3><div class="sw"><div><i style="background:#0F2B2A"></i><small>Night</small></div><div><i style="background:#1D4B49"></i><small>Teal</small></div><div><i style="background:#E8B76A"></i><small>Glow</small></div><div><i style="background:#F4EEE3"></i><small>Ink</small></div><div><i style="background:#FBF8F3"></i><small>Page</small></div></div>
    <ul><li><b>Type:</b> Fraunces for questions and your words; Work Sans for controls.</li><li><b>Motion:</b> a 9s breathing glow, 0.5s rise on each screen. Off with reduced motion.</li><li><b>Touch:</b> buttons 44px+, one primary per screen.</li><li><b>Contrast:</b> body text 7:1 or better on night teal.</li><li><b>Copy:</b> short, plain, no hype, no em-dashes.</li></ul>`;

  function go(id: string) {
    clearTimeout((window as any).__t);
    const s = S.find((x) => x.id === id)!; cur = id;
    scr.innerHTML = s.html(); scr.scrollTop = 0;
    pg.style.width = `${s.p * 100}%`;
    notes.innerHTML = `<h3>${s.g}</h3><h2>${s.n}</h2>${s.notes}${systemNotes}`;
    scr.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(b.dataset.go!)));
    scr.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.pick!;
      if (picks.includes(v)) picks = picks.filter((x) => x !== v); else if (picks.length < 3) picks.push(v);
      scr.querySelectorAll<HTMLElement>('[data-pick]').forEach((c) => c.setAttribute('aria-pressed', String(picks.includes(c.dataset.pick!))));
    }));
    s.wire?.(go);
    document.querySelectorAll<HTMLElement>('.nb').forEach((n) => n.toggleAttribute('aria-current', n.dataset.id === id));
    document.querySelectorAll<HTMLElement>('.nb').forEach((n) => n.setAttribute('aria-current', String(n.dataset.id === id)));
    history.replaceState(null, '', `#${id}`);
  }

  const groups = [...new Set(S.map((s) => s.g))];
  $('map').innerHTML = groups.map((g) => `<div class="grp">${g}</div>${S.filter((s) => s.g === g).map((s, i) => `<button class="nb" data-id="${s.id}" aria-current="false"><b>${S.indexOf(s) + 1}</b>${s.n}</button>`).join('')}`).join('');
  document.querySelectorAll<HTMLElement>('.nb').forEach((n) => n.addEventListener('click', () => go(n.dataset.id!)));

  document.querySelectorAll<HTMLButtonElement>('.tog button').forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f!;
    if (f === 'motion') { const off = ux.dataset.motion !== 'off'; ux.dataset.motion = off ? 'off' : 'on'; b.setAttribute('aria-pressed', String(!off)); b.textContent = off ? 'Glow off' : 'Glow on'; return; }
    $('device').dataset.f = f;
    document.querySelectorAll<HTMLButtonElement>('.tog button[data-f="phone"], .tog button[data-f="desk"]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));

  const start = location.hash.slice(1);
  go(S.some((s) => s.id === start) ? start : 'welcome');
</script>
