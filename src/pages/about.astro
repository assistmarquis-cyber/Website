---
import NeuralCanvas from '../components/NeuralCanvas.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Gallery from '../components/Gallery.astro';
import { welcome } from '../data/gallery';
import { site, affiliations } from '../data/site';
import portrait from '../assets/portrait.jpg';
import panel from '../assets/stage-panel.jpg';
import summit from '../assets/summit-session.jpg';
---
<Base title="About Marquis Harmon | Cultural Technologist, AI Strategist & Digital Griot" description="Marquis Harmon is a cultural technologist and AI strategist, founder of MAEx, and author of Thinking Out Loud to Myself: Psalms 1:3. He has spoken at the United Nations, COP22 and Harvard Business School.">
  <section class="section mind"><NeuralCanvas />
    <div class="wrap split even">
      <div class="photo"><Image src={portrait} alt="Portrait of Marquis Harmon. Photo: LHT.HSE Creative Studio" widths={[480, 800, 1000]} sizes="(min-width:900px) 45vw, 100vw" loading="eager" /><p style="font-size:12px;color:var(--muted);margin-top:8px">Photo: LHT.HSE Creative Studio</p></div>
      <div class="stack g22">
        <span class="eyebrow">About Marquis</span>
        <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">Strategist, founder and storyteller: the Digital Griot.</h1>
        <p>Marquis Harmon is a cultural technologist and AI strategist who has advised leaders across multiple industries as a strategic and leadership consultant.</p>
        <p>He founded MAEx, where he trains enterprise executives on AI adoption through the G.O.D. Framework, and a fintech venture grounded in regenerative economics.</p>
        <p>He has spoken at the United Nations, COP22, the World Syrian Refugee Summit and Hive at Harvard Business School.</p>
        <div class="btn-row"><a class="btn btn-primary" href="/contact/">Request availability</a></div>
      </div>
    </div>
  </section>
  <section class="section mint" id="affiliations"><div class="wrap">
    <div class="head"><span class="eyebrow">Affiliations and partners</span><h2>Where the work connects.</h2></div>
    <div class="grid c2">
      {affiliations.map((a) => (
        <div class="card"><span class="eyebrow">{a.role}</span><h3>{a.name}</h3><div><a class="link-arrow" href={a.url} target="_blank" rel="noopener">{a.cta} ↗</a></div></div>
      ))}
    </div>
  </div></section>
  <section class="section dark" id="mindset"><div class="wrap split">
    <div class="stack g16"><span class="eyebrow">Mindset coach and supreme accountability partner</span><h2>Know your voice. Trust your instinct. Act fast.</h2></div>
    <div class="stack g16">
      <p>I spent years in survival mode, chasing what I wanted most and losing because of it. Learning to tell the voice of survival from the voice of instinct changed everything, and now I help others do the same.</p>
      <p>We start by talking about what's hardest right now. I listen closely, then we identify the impulses and patterns running you, assess them, and rapidly prototype a first solution so you're moving, not just reflecting.</p>
      <p>Work with me one-on-one on mindset and decision-making under pressure, or bring me in for speaking coaching, workshops, and keynotes.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/mindset-coaching/">Book a conversation</a></div>
    </div>
  </div></section>
  <section class="section mint" id="book"><div class="wrap split even">
    <div class="stack g22">
      <span class="eyebrow">The book</span>
      <h2><em>Thinking Out Loud to Myself: Psalms 1:3</em></h2>
      <p>The memoir by Marquis Harmon, available now on Amazon.</p>
      <div><a class="btn btn-primary" href={site.bookUrl} rel="noopener" target="_blank">Get the book on Amazon</a></div>
    </div>
    <div class="grid c2">
      <div class="photo wide"><Image src={panel} alt="Marquis Harmon speaking at the podium during a COP22 panel, Marrakech" widths={[400, 700]} /></div>
      <div class="photo wide"><Image src={summit} alt="Marquis Harmon speaking on a panel at the World Humanitarian Summit, Istanbul" widths={[400, 700]} /></div>
    </div>
  </div></section>
  <Gallery eyebrow="In the room" title="Where the big picture gets built, together." text="From Hive gatherings to hands-on prototyping sessions, these are the rooms where Marquis practices what he teaches." />
  <CtaBand photo={welcome} title="Bring Marquis to your next leadership moment." text="Share your objectives and we'll respond with availability." />
</Base>
