---
import NeuralCanvas from '../../components/NeuralCanvas.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="You're in | G.O.D. Coach | Marquis Harmon" description="Your G.O.D. Coach purchase is complete." noindex>
  <section class="section mind"><NeuralCanvas /><div class="wrap stack g22" style="max-width:640px">
    <span class="eyebrow">Payment received</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem)">Your G.O.D. Coach is on its way.</h1>
    <p class="lede">Check your inbox in the next few minutes for an email from book@bigpicturearchitect.com with your prompt and setup steps. If it isn't there, look in spam or promotions.</p>
    <p>Want help getting it running? Reply to that email and tell me what you want the coach to help you with.</p>
    <div><a class="btn btn-secondary" href="/">Back to home</a></div>
  </div></section>
</Base>
