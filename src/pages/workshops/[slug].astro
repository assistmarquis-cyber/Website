---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Model from '../../components/Model.astro';
import { workshops } from '../../data/site';
import { ph } from '../../data/ph';
import god from '../../assets/god-framework.jpg';
import { roundtable, prototype, energizer } from '../../data/gallery';
export function getStaticPaths() { return workshops.map((w) => ({ params: { slug: w.slug }, props: { w } })); }
const { w } = Astro.props;
const img = w.slug === 'ai-adoption-god-framework' ? god : w.slug === 'creative-cornerstore' ? roundtable : prototype;
const alt = w.slug === 'ai-adoption-god-framework' ? 'The G.O.D. Framework diagram: Generator, Operator, Destroyer' : w.slug === 'creative-cornerstore' ? 'A facilitator leads a roundtable discussion during a Creative CornerStore-style session' : 'A team builds a rapid prototype on the floor during a hackathon';
const model = [
  ['Discover', 'Stakeholder briefing on audience, objectives and business context.'],
  ['Design', 'Exercises and stories shaped around your strategy, reviewed with your team.'],
  ['Deliver', 'Facilitation on-site or virtual, for leadership teams or larger cohorts.'],
  ['Measure', 'Agreed success measures, participant feedback and a post-session action plan.'],
];
---
<Base title={`${w.seo} | Marquis Harmon`} description={`${w.summary} Enterprise workshop by Marquis Harmon.`}>
  <section class="section">
    <div class="wrap split even">
      <div class="stack g22">
        <p class="crumbs"><a href="/workshops/">Enterprise workshops</a> / {w.short}</p>
        <span class="eyebrow">{w.short}</span>
        <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">{w.title}</h1>
        <p style="font:500 1.3rem var(--serif);color:var(--primary)">{w.tagline}</p>
        <p class="lede">{w.summary}</p>
        <div class="btn-row"><a class="btn btn-primary" href="/contact/">Request program details</a></div>
      </div>
      <div class="photo wide"><Image src={img} alt={alt} widths={[480, 800, 1000]} sizes="(min-width:900px) 45vw, 100vw" /></div>
    </div>
  </section>
  {w.outcomes.length > 0 && <section class="section mint"><div class="wrap">
    <div class="head"><span class="eyebrow">{w.slug === 'ai-adoption-god-framework' ? 'Business outcomes' : 'Outcomes'}</span></div>
    <div class="grid c3">
      {w.outcomes.map(([h, p]) => <div class="card"><h3 set:html={ph(h)} />{p && <p>{p}</p>}</div>)}
    </div>
  </div></section>}
  <Model title="Built for your organization, not pulled off a shelf." items={model} />
  <CtaBand photo={energizer} title="Planning an offsite or leadership program?" text="Share your objectives and we'll recommend the right format." />
</Base>
