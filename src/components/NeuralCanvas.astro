<canvas id="neural" aria-hidden="true"></canvas>
<script>
  // A living network of neurons: nodes drift, link up when close, fire pulses
  // along their connections and lean toward the visitor's cursor.
  const cv = document.getElementById('neural') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type N = { x: number; y: number; vx: number; vy: number; r: number };
  let W = 0, H = 0, nodes: N[] = [], pulses: { a: N; b: N; t: number }[] = [];
  const mouse = { x: -999, y: -999 };
  const resize = () => {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round(Math.min(110, (W * H) / 11000));
    nodes = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35, r: Math.random() * 1.8 + .8 }));
  };
  const LINK = 130;
  const frame = () => {
    ctx.clearRect(0, 0, W, H);
    for (const p of nodes) {
      const dx = mouse.x - p.x, dy = mouse.y - p.y, d = Math.hypot(dx, dy);
      if (d < 180) { p.vx += dx / d * .015; p.vy += dy / d * .015; }
      p.vx *= .99; p.vy *= .99; p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > W) p.vx *= -1;
      if (p.y < 0 || p.y > H) p.vy *= -1;
    }
    for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
      const a = nodes[i], b = nodes[j], d = Math.hypot(a.x - b.x, a.y - b.y);
      if (d > LINK) continue;
      ctx.strokeStyle = `rgba(143,208,201,${(1 - d / LINK) * .35})`; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
      if (!reduce && Math.random() < .0009) pulses.push({ a, b, t: 0 });
    }
    for (const p of nodes) {
      const near = Math.hypot(mouse.x - p.x, mouse.y - p.y) < 140;
      ctx.fillStyle = near ? '#FFB4A8' : 'rgba(228,242,240,.85)';
      ctx.beginPath(); ctx.arc(p.x, p.y, near ? p.r + 1.2 : p.r, 0, 7); ctx.fill();
    }
    pulses = pulses.filter((s) => (s.t += .025) < 1);
    for (const s of pulses) {
      const x = s.a.x + (s.b.x - s.a.x) * s.t, y = s.a.y + (s.b.y - s.a.y) * s.t;
      const g = ctx.createRadialGradient(x, y, 0, x, y, 10);
      g.addColorStop(0, 'rgba(255,180,168,.95)'); g.addColorStop(1, 'rgba(255,180,168,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, 10, 0, 7); ctx.fill();
    }
    if (!reduce) requestAnimationFrame(frame);
  };
  const host = cv.parentElement!;
  host.addEventListener('pointermove', (e) => { const r = cv.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
  host.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });
  addEventListener('resize', resize);
  resize(); frame();
</script>
