---
import { nav } from '../data/site';
const path = Astro.url.pathname;
const cur = (h: string) => (path.startsWith(h) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><b>Marquis Harmon</b><span>The Big Picture <span class="ark">Ark</span>itect</span></a>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={cur(n.href)}>{n.label}</a>)}
      <a class="btn btn-primary" href="/contact/">Request availability</a>
    </nav>
    <button class="menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2A1D14" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
    </button>
  </div>
  <nav class="mobile-nav" id="mnav" aria-label="Mobile">
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a class="btn btn-primary" href="/contact/">Request availability</a>
  </nav>
</header>
<script>
  const b = document.getElementById('menu-btn')!, m = document.getElementById('mnav')!;
  b.addEventListener('click', () => {
    const o = m.classList.toggle('open');
    b.setAttribute('aria-expanded', String(o));
  });
</script>
