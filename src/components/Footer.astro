---
import { nav, site } from '../data/site';
import { ph } from '../data/ph';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <a class="brand" href="/"><b>Marquis Harmon</b><span>The Big Picture <span class="ark" style="color:#8FD0C9">Ark</span>itect</span></a>
      <nav aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/contact/">Contact</a>
      </nav>
    </div>
    <div class="bot">
      <div class="legal-line">
        <span>© {new Date().getFullYear()} {site.legal}, a Texas limited liability company based in Philadelphia, Pennsylvania. <Fragment set:html={ph('[contact email]')} />. <a href="/privacy/">Privacy policy</a> · <a href="/terms/">Terms</a></span>
        <span>Coaching is not therapy or medical care.</span>
      </div>
    </div>
  </div>
</footer>
