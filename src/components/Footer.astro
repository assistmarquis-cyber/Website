    </div>
    <div class="bot">
      <span>© {new Date().getFullYear()} {site.legal}. All rights reserved.</span>
      <span><a href="/privacy/">Privacy policy</a> &nbsp;·&nbsp; <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>
