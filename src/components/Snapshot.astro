---
// A casual, slightly tilted snapshot with a handwritten-style caption.
// Used on the coaching funnel pages to keep things personal, not polished.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; cap?: string; tilt?: number; eager?: boolean; sizes?: string }
const { src, alt, cap, tilt = -2, eager = false, sizes = '(min-width:900px) 30vw, 80vw' } = Astro.props;
---
<figure class="snap" style={`--tilt:${tilt}deg`}>
  <Image src={src} alt={alt} widths={[360, 640, 900]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
  {cap && <figcaption>{cap}</figcaption>}
</figure>
