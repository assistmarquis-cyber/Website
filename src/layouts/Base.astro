---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoLayer from '../components/PhotoLayer.astro';
import { site } from '../data/site';
import { siteGraph, ids } from '../data/seo';
interface Props { title: string; description: string; noindex?: boolean; bare?: boolean; schema?: object[] }
const { title, description, noindex = false, bare = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL('/og.jpg', site.url).href;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph,
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, isPartOf: { '@id': ids.website }, about: { '@id': ids.person } },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Marquis Harmon — The Big Picture Arkitect" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#1B6663" />
  <meta name="msvalidate.01" content="9CCDEE8F065EF2A23B4214B67AA9F32C" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  <script is:inline>
    // Teleport between pages: remember where the visitor clicked, and open the next page from that spot.
    addEventListener('click', function (e) { try { sessionStorage.setItem('tp', JSON.stringify([e.clientX / innerWidth * 100, e.clientY / innerHeight * 100])); } catch (_) {} }, true);
    addEventListener('pagereveal', function () { try { var p = JSON.parse(sessionStorage.getItem('tp') || '[50,50]'); document.documentElement.style.setProperty('--tx', p[0] + '%'); document.documentElement.style.setProperty('--ty', p[1] + '%'); } catch (_) {} });
  </script>
</head>
<body>
  {!bare && <div class="thread" aria-hidden="true"><span id="thread-fill"></span></div>}
  {!bare && <Header />}
  <main id="main"><slot /></main>
  {!bare && <PhotoLayer />}
  {!bare && <Footer />}
  <script>
    // Motion layer: scroll reveals, the neural-thread progress bar and parallax backgrounds.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sel = '.section .head, .card, .quote, .pain > div, .step, .model > div, .photo, .reveal, .fn-card, .reel figure';
    const els = document.querySelectorAll<HTMLElement>(sel);
    if (!reduce && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('motion');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => {
        const sibs = el.parentElement ? Array.from(el.parentElement.children).indexOf(el) : 0;
        el.style.setProperty('--d', `${Math.min(sibs, 6) * 70}ms`);
        io.observe(el);
      });
    }
    const fill = document.getElementById('thread-fill');
    const para = document.querySelectorAll<HTMLElement>('[data-parallax]');
    let ticking = false;
    const onScroll = () => {
      ticking = false;
      const h = document.documentElement.scrollHeight - innerHeight;
      if (fill) fill.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
      if (reduce) return;
      para.forEach((el) => {
        const r = el.parentElement!.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return;
        const k = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
        el.style.transform = `translate3d(0, ${k * -60}px, 0) scale(1.15)`;
      });
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    onScroll();
  </script>
</body>
</html>
